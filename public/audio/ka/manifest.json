[
  {
    "text": "გამარჯობა",
    "spokenText": "გამარჯობა",
    "file": "47cf93e616c76ccf.mp3"
  },
  {
    "text": "დიდი მადლობა",
    "spokenText": "დიდი მადლობა",
    "file": "b2384a1260a1fa18.mp3"
  },
  {
    "text": "ბოდიში",
    "spokenText": "ბოდიში",
    "file": "eab6f448b8c9f687.mp3"
  },
  {
    "text": "თუ შეიძლება",
    "spokenText": "თუ შეიძლება",
    "file": "8e7354a205d4e633.mp3"
  },
  {
    "text": "ქართული არ ვიცი",
    "spokenText": "ქართული არ ვიცი",
    "file": "f62a5091476eb2ae.mp3"
  },
  {
    "text": "რუსული იცით?",
    "spokenText": "რუსული იცით?",
    "file": "46551e17fceff401.mp3"
  },
  {
    "text": "ინგლისური იცით?",
    "spokenText": "ინგლისური იცით?",
    "file": "76603fabfbe3f84f.mp3"
  },
  {
    "text": "ვერ გავიგე",
    "spokenText": "ვერ გავიგე",
    "file": "b6de7404e2dffb32.mp3"
  },
  {
    "text": "ჩამოვდივარ",
    "spokenText": "ჩამოვდივარ",
    "file": "91af36be792d51ab.mp3"
  },
  {
    "text": "კართან დატოვეთ",
    "spokenText": "კართან დატოვეთ",
    "file": "18dc7e6816906ccd.mp3"
  },
  {
    "text": "დამელოდეთ, თუ შეიძლება",
    "spokenText": "დამელოდეთ, თუ შეიძლება",
    "file": "e905019286deabeb.mp3"
  },
  {
    "text": "აქ ვარ",
    "spokenText": "აქ ვარ",
    "file": "10f8dc02bbaf4046.mp3"
  },
  {
    "text": "მარჯვნივ",
    "spokenText": "მარჯვნივ",
    "file": "303c006c6280a8f9.mp3"
  },
  {
    "text": "მარცხნივ",
    "spokenText": "მარცხნივ",
    "file": "397a42b048a36745.mp3"
  },
  {
    "text": "პირდაპირ",
    "spokenText": "პირდაპირ",
    "file": "9f2bd0fe656ee099.mp3"
  },
  {
    "text": "აქ გააჩერეთ, თუ შეიძლება",
    "spokenText": "აქ გააჩერეთ, თუ შეიძლება",
    "file": "bd2055e0403f63d0.mp3"
  },
  {
    "text": "ერთი ამერიკანო, თუ შეიძლება",
    "spokenText": "ერთი ამერიკანო, თუ შეიძლება",
    "file": "d9aa679f6526b964.mp3"
  },
  {
    "text": "წასაღებად",
    "spokenText": "წასაღებად",
    "file": "629e52f940f09f22.mp3"
  },
  {
    "text": "უშაქროდ",
    "spokenText": "უშაქროდ",
    "file": "8d6025bce8d31f60.mp3"
  },
  {
    "text": "გამიცხელეთ, თუ შეიძლება",
    "spokenText": "გამიცხელეთ, თუ შეიძლება",
    "file": "93198673cc7ea76c.mp3"
  },
  {
    "text": "ბარათით შეიძლება?",
    "spokenText": "ბარათით შეიძლება?",
    "file": "cb87adb53a0a6bc5.mp3"
  },
  {
    "text": "ჩეკი არ მინდა",
    "spokenText": "ჩეკი არ მინდა",
    "file": "c950b38cad0322c7.mp3"
  },
  {
    "text": "წყალი, თუ შეიძლება",
    "spokenText": "წყალი, თუ შეიძლება",
    "file": "fcca15b86b05f456.mp3"
  },
  {
    "text": "ძალიან გემრიელია",
    "spokenText": "ძალიან გემრიელია",
    "file": "4d91ee48d159bc25.mp3"
  },
  {
    "text": "რა ღირს?",
    "spokenText": "რა ღირს?",
    "file": "f12404d4a2496574.mp3"
  },
  {
    "text": "პარკი არ მინდა",
    "spokenText": "პარკი არ მინდა",
    "file": "b2deae4c8829e998.mp3"
  },
  {
    "text": "ეს ახალია?",
    "spokenText": "ეს ახალია?",
    "file": "f23a8f9d22e58fc3.mp3"
  },
  {
    "text": "ხურდა არ მინდა",
    "spokenText": "ხურდა არ მინდა",
    "file": "208cd0e29a00a078.mp3"
  },
  {
    "text": "ეს, თუ შეიძლება",
    "spokenText": "ეს, თუ შეიძლება",
    "file": "00c10c4465909011.mp3"
  },
  {
    "text": "ერთი კილო, თუ შეიძლება",
    "spokenText": "ერთი კილო, თუ შეიძლება",
    "file": "fa9d3c9c53de398d.mp3"
  },
  {
    "text": "კი",
    "spokenText": "კი",
    "file": "34042e882b3cb7d3.mp3"
  },
  {
    "text": "არა",
    "spokenText": "არა",
    "file": "d2473944f5da5703.mp3"
  },
  {
    "text": "აფთიაქი",
    "spokenText": "აფთიაქი",
    "file": "5073822e215fa8b0.mp3"
  },
  {
    "text": "პური",
    "spokenText": "პური",
    "file": "42913efccf517c38.mp3"
  },
  {
    "text": "ყავა",
    "spokenText": "ყავა",
    "file": "cb7009e16963dc3f.mp3"
  },
  {
    "text": "შესასვლელი",
    "spokenText": "შესასვლელი",
    "file": "259bdd3fd14fce71.mp3"
  },
  {
    "text": "გასასვლელი",
    "spokenText": "გასასვლელი",
    "file": "d4ca437a4316abfa.mp3"
  },
  {
    "text": "ღიაა",
    "spokenText": "ღიაა",
    "file": "be776a80af225858.mp3"
  },
  {
    "text": "დაკეტილია",
    "spokenText": "დაკეტილია",
    "file": "bc904cad9b01563d.mp3"
  },
  {
    "text": "გაჩერება",
    "spokenText": "გაჩერება",
    "file": "bed4430049c647a5.mp3"
  },
  {
    "text": "წყალი არ არის",
    "spokenText": "წყალი არ არის",
    "file": "2d63f2009827d9fd.mp3"
  },
  {
    "text": "ინტერნეტი არ მუშაობს",
    "spokenText": "ინტერნეტი არ მუშაობს",
    "file": "30659eb83db8a75f.mp3"
  },
  {
    "text": "გათბობა არ მუშაობს",
    "spokenText": "გათბობა არ მუშაობს",
    "file": "5d43ca05d9579569.mp3"
  },
  {
    "text": "შეგიძლიათ დამეხმაროთ?",
    "spokenText": "შეგიძლიათ დამეხმაროთ?",
    "file": "479cc990aad5202b.mp3"
  },
  {
    "text": "როდის მოხვალთ?",
    "spokenText": "როდის მოხვალთ?",
    "file": "058851196225e47c.mp3"
  },
  {
    "text": "სახლში ვარ",
    "spokenText": "სახლში ვარ",
    "file": "476b27a3119874e2.mp3"
  },
  {
    "text": "ხვალ შეიძლება?",
    "spokenText": "ხვალ შეიძლება?",
    "file": "93acf039cb4f1bea.mp3"
  },
  {
    "text": "ხვალ მოვალ",
    "spokenText": "ხვალ მოვალ",
    "file": "cc01ede9c8014937.mp3"
  },
  {
    "text": "სად არის ავტობუსის გაჩერება?",
    "spokenText": "სად არის ავტობუსის გაჩერება?",
    "file": "dcbc05dd54af919b.mp3"
  },
  {
    "text": "სად არის მეტრო?",
    "spokenText": "სად არის მეტრო?",
    "file": "fe30cca03cfbdb7b.mp3"
  },
  {
    "text": "რა ღირს ბილეთი?",
    "spokenText": "რა ღირს ბილეთი?",
    "file": "1584e3637fbd0983.mp3"
  },
  {
    "text": "სად ვიყიდო ბილეთი?",
    "spokenText": "სად ვიყიდო ბილეთი?",
    "file": "cb5d5dd1f01631ae.mp3"
  },
  {
    "text": "ჩადიხართ?",
    "spokenText": "ჩადიხართ?",
    "file": "512d318e30fe3394.mp3"
  },
  {
    "text": "ეს ჩემი გაჩერებაა",
    "spokenText": "ეს ჩემი გაჩერებაა",
    "file": "b6acbe53e24de4a9.mp3"
  },
  {
    "text": "უკვე გადავიხადე",
    "spokenText": "უკვე გადავიხადე",
    "file": "920e6e36529855f5.mp3"
  },
  {
    "text": "გაჩერებაზე გამიჩერეთ, თუ შეიძლება",
    "spokenText": "გაჩერებაზე გამიჩერეთ, თუ შეიძლება",
    "file": "5f63df69650eb644.mp3"
  },
  {
    "text": "რა გქვიათ?",
    "spokenText": "რა გქვიათ?",
    "file": "71cea883f1737b59.mp3"
  },
  {
    "text": "მე ნიკა მქვია",
    "spokenText": "მე ნიკა მქვია",
    "file": "fe2103ff5beca714.mp3"
  },
  {
    "text": "ძალიან სასიამოვნოა",
    "spokenText": "ძალიან სასიამოვნოა",
    "file": "0242304b1a30f7a5.mp3"
  },
  {
    "text": "აქ ვცხოვრობ",
    "spokenText": "აქ ვცხოვრობ",
    "file": "e000d78e61be3fbd.mp3"
  },
  {
    "text": "როგორ ხართ?",
    "spokenText": "როგორ ხართ?",
    "file": "b72bdda0d0d7df6f.mp3"
  },
  {
    "text": "კარგად, მადლობა",
    "spokenText": "კარგად, მადლობა",
    "file": "06ea36e96fcc7f0d.mp3"
  },
  {
    "text": "ქართულს ვსწავლობ",
    "spokenText": "ქართულს ვსწავლობ",
    "file": "97447a55a6c08b67.mp3"
  },
  {
    "text": "ნახვამდის",
    "spokenText": "ნახვამდის",
    "file": "dd2fc3afe7029a86.mp3"
  },
  {
    "text": "გამარჯობა!",
    "spokenText": "გამარჯობა!",
    "file": "3f3b01e6b8eeaae0.mp3"
  },
  {
    "text": "ქვემოთ ვარ.",
    "spokenText": "ქვემოთ ვარ.",
    "file": "ba9d6e427bbd2467.mp3"
  },
  {
    "text": "სად დავტოვო?",
